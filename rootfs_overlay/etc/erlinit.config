# erlinit configuration for the Mobvoi TicWatch Pro 3
#
# Override from your app by following:
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config

# Uncomment for debug prints
# -v

# The watch's own display. lk2nd leaves the panel lit, the device tree
# carries a simple-framebuffer and the kernel binds it with SimpleDRM, so
# fbcon gives us a text console on tty1. There is no serial port worth
# soldering to on this device — if you need a console before the BEAM is
# up, use the initramfs's USB-network telnetd instead.
-c tty1

--warn-unused-tty

# Use nbtty for nicer terminal handling.
-s "/usr/bin/nbtty"

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the kernel virtual filesystems Nerves expects.
-m debugfs:/sys/kernel/debug:debugfs:nodev,noexec,nosuid
-m pstore:/sys/fs/pstore:pstore:nodev,noexec,nosuid:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu
# configfs lets vintage_net_direct (or any userspace tool) reconfigure the
# USB gadget. The initramfs already brought it up before switch_root;
# remounting configfs here gives the running system a window onto the same
# kernel state so it can manage usb0.
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# Subpartitions of the stock `userdata` partition, mapped by kpartx in the
# initramfs. These are stable aliases created there — `userdata` is not at
# a fixed eMMC partition number across TicWatch Pro 3 firmware revisions,
# so nothing in this system names /dev/mmcblk0pNN. The boot partition is
# read-only; application data is f2fs and gets formatted by nerves_runtime
# on first boot.
-m /dev/nerves-boot:/boot:ext2:ro,nodev,noexec,nosuid:
-m /dev/nerves-app:/root:f2fs:nodev:

# Stock Android partitions, read-only. The Broadcom Wi-Fi NVRAM and the
# Bluetooth patch RAM image live here and are specific to each watch, so
# they cannot be shipped in the rootfs — ticwatch-firmware-setup reads
# them from these mounts at boot. Resolved by GPT name in the initramfs,
# and simply absent if the partition is missing.
-m /dev/nerves-vendor:/mnt/vendor:auto:ro,nodev,noexec,nosuid:
-m /dev/nerves-persist:/mnt/persist:auto:ro,nodev,noexec,nosuid:

# Erlang release search path
-r /srv/erlang

# Hostname of the form "nerves-<last 4 chars of serial number>"
-d /usr/bin/boardid
-n nerves-%-.4s

# If using shoehorn, start the shoehorn OTP release first
--boot shoehorn

# Kernel config fragment for nerves_system_tickwatch_pro3.
#
# The base config is linux-7.1.defconfig, taken verbatim from
# postmarketOS's linux-postmarketos-qcom-msm89x7 (config-postmarketos-
# qcom-msm89x7.aarch64). That config is the known-good one for this SoC
# family, so keeping it unmodified and expressing our deltas here means a
# pmaports refresh is a file copy rather than a merge.
#
# Buildroot merges this on top and runs `olddefconfig`, so anything whose
# dependencies are unmet is dropped rather than breaking the build.

# --- Mounted before the rootfs exists, so it cannot be a module --------------
#
# postmarketOS boots via an initramfs that carries kernel modules and
# modprobes what it needs. This system's initramfs deliberately carries
# none: the cpio has to fit, with the kernel and the DTB, inside the
# 50 MiB of boot memory lk2nd gives us. So everything on the path to
# `switch_root` is built in instead.
#
# squashfs is the rootfs itself; ext2 is the boot subpartition erlinit
# mounts at /boot; f2fs is the application-data subpartition.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_EXT2_FS=y
CONFIG_F2FS_FS=y

# Keep USB Ethernet available from early kernel startup through userspace.
CONFIG_USB_ETH=y
CONFIG_USB_CONFIGFS=y

# Scale CPU frequency with scheduler demand, including before userspace starts.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# Keep postmarketOS's CONFIG_CFG80211_DEFAULT_PS=y. Forcing power saving off
# did not resolve the transport failures; no periodic userspace override is
# needed. The SDIO clock must also remain at the upstream supported 50 MHz.

# Input is how you interact with a watch; no reason to defer it.
CONFIG_INPUT_EVDEV=y

# --- Console -----------------------------------------------------------------
#
# fbcon on a 454x454 panel with the default 8x16 font is unreadable at arm's
# length. extlinux.conf asks for fbcon=font:TER16x32, which needs the font
# compiled in.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# --- Toolchain ---------------------------------------------------------------
#
# postmarketOS uses Clang; Nerves uses the GCC 15 aarch64 toolchain.
# Shadow call stack is a clang-only arm64
# feature — olddefconfig would drop it anyway once CC_HAVE_SHADOW_CALL_STACK
# goes unmet, but saying so here documents why it disappears.
# CONFIG_SHADOW_CALL_STACK is not set

# Module signing buys nothing here: the modules ship inside a read-only
# squashfs that fwup writes as one image, and the signing key would be
# generated fresh on every build, which defeats BR2_REPRODUCIBLE.
#
# Turning it off means turning off the lockdown LSM, which is what pulls
# it in (`select MODULE_SIG if MODULES` in security/lockdown/Kconfig).
# Lockdown does nothing on this watch in any case: it gates on secure
# boot or an explicit lockdown= parameter, and neither exists here.
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_SECURITY_LOCKDOWN_LSM_EARLY is not set
# CONFIG_MODULE_SIG is not set

# Compressed modules need a kmod built with the matching decompressor.
# Nerves' kmod is not, so a compressed module is one that silently fails
# to load.
# CONFIG_MODULE_COMPRESS is not set

# --- Debug info --------------------------------------------------------------
#
# postmarketOS builds with full DWARF5 plus BTF. BTF is the expensive one
# here: it needs pahole on the build host, and unlike DWARF it is not
# stripped out of the kernel image — it ships in a .BTF section for BPF
# introspection at runtime. That is several megabytes charged against the
# 50 MiB lk2nd gives the kernel, initramfs and device tree together, to
# support tooling this system does not carry.
#
# Turn BTF back on with BR2_LINUX_KERNEL_NEEDS_HOST_PAHOLE=y in
# nerves_defconfig if you want to run bpftrace on the watch.
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# DWARF stays off too. It does not reach the target — the image is built
# from a stripped Image — but it makes every object file several times
# larger and slows the build down for nothing.
CONFIG_DEBUG_INFO_NONE=y

# DSI panel: the SDM429W's 12nm DSI PHY and the rover's AMOLED panel driver,
# so the display pipeline can be powered down instead of held on by the
# bootloader framebuffer.
CONFIG_DRM_MSM_DSI_12NM_PHY=y
CONFIG_DRM_PANEL_MOBVOI_ROVER=m

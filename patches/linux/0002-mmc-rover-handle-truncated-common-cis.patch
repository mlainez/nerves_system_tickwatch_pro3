From: TicWatch Nerves maintainers
Subject: [PATCH] mmc: sdio: handle rover's unterminated common CIS

On the tested Mobvoi rover, the BCM43430 common CIS at 0x1070 contains
MANFID, FUNCID and FUNCE, followed by zeros at 0x1080 instead of END.
Scanning beyond these records eventually fails with -ETIMEDOUT. A live
kretprobe supplying END at this exact address allowed enumeration.

Limit the workaround to rover, the observed chip, the common CIS pointer,
and a null tuple at the observed boundary. Function CIS parsing and other
boards are unchanged. Do not modify the chip's OTP or calibration data.

--- a/drivers/mmc/core/sdio_cis.c
+++ b/drivers/mmc/core/sdio_cis.c
@@ -12,6 +12,7 @@
 
 #include <linux/kernel.h>
 #include <linux/slab.h>
+#include <linux/of.h>
 
 #include <linux/mmc/host.h>
 #include <linux/mmc/card.h>
@@ -247,5 +248,6 @@ static int sdio_read_cis(struct mmc_card *card, struct sdio_func *func)
 	struct sdio_func_tuple *this, **prev;
 	unsigned i, ptr = 0;
+	unsigned int cis_start;
 
 	/*
 	 * Note that this works for the common CIS (function number 0) as
@@ -268,6 +270,8 @@ static int sdio_read_cis(struct mmc_card *card, struct sdio_func *func)
 		ptr |= x << (i * 8);
 	}
 
+	cis_start = ptr;
+
 	if (func)
 		prev = &func->tuples;
 	else
@@ -286,6 +290,16 @@ static int sdio_read_cis(struct mmc_card *card, struct sdio_func *func)
 		if (ret)
 			break;
 
+		/* Rover's common CIS lacks END after its complete FUNCE tuple. */
+		if (!func && cis_start == 0x1070 && ptr == 0x1081 &&
+		    tpl_code == 0x00 && card->cis.vendor == 0x02d0 &&
+		    card->cis.device == 0xa9a6 &&
+		    of_machine_is_compatible("mobvoi,rover")) {
+			pr_info("%s: rover: terminating unterminated common CIS at 0x1080\n",
+				mmc_hostname(card->host));
+			break;
+		}
+
 		/* 0xff means we're done */
 		if (tpl_code == 0xff)
 			break;

From c268d1ffb149753c6bdad8fc1d45d3786a24d570 Mon Sep 17 00:00:00 2001
From: Lars Wikman <lars@underjord.io>
Date: Thu, 15 Oct 2026 09:40:07 +0000
Subject: [PATCH] arm64: dts: qcom: msm8937: let the SoC reach XO shutdown

The deepest idle state was L2 power collapse, which the RPM never hears
of, so XO stays on and CX at its active level through any idle period
or suspend: the RPM's vlow and vmin counts stayed at zero.

Add the system level downstream calls "system-pc" (PSCI mode 3 at the
third level, with the RPM notified) as a domain above the cluster, and
the MPM below it: powering it off hands the RPM the wakeup interrupts
that stay armed while the GIC is off. Route the SPMI interrupt through
the MPM, as the power key, RTC alarm and charger all arrive on it.

The pin map and the MPM's offset in RPM message RAM are from the
downstream MSM8937 tree.

Signed-off-by: Lars Wikman <lars@underjord.io>
---
 arch/arm64/boot/dts/qcom/msm8937.dtsi | 41 +++++++++++++++++++++++++--
 1 file changed, 39 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8937.dtsi b/arch/arm64/boot/dts/qcom/msm8937.dtsi
index 609babf..c8682db 100644
--- a/arch/arm64/boot/dts/qcom/msm8937.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8937.dtsi
@@ -195,6 +195,15 @@
 				exit-latency-us = <1000>;
 				min-residency-us = <6500>;
 			};
+
+			/* L2 off and the RPM told, so it may turn XO off. */
+			system_sleep_0: system-power-collapse {
+				compatible = "domain-idle-state";
+				arm,psci-suspend-param = <0x42000353>;
+				entry-latency-us = <2000>;
+				exit-latency-us = <8782>;
+				min-residency-us = <20000>;
+			};
 		};
 
 		idle-states {
@@ -407,9 +416,16 @@
 
 		cluster_pd: power-domain-cluster {
 			#power-domain-cells = <0>;
+			power-domains = <&system_pd>;
 			domain-idle-states = <&cluster_sleep_0>;
 		};
 
+		system_pd: power-domain-system {
+			#power-domain-cells = <0>;
+			power-domains = <&mpm>;
+			domain-idle-states = <&system_sleep_0>;
+		};
+
 		cpu_pd0: power-domain-cpu0 {
 			#power-domain-cells = <0>;
 			power-domains = <&cluster_pd>;
@@ -501,6 +517,20 @@
 				};
 			};
 		};
+
+		mpm: interrupt-controller {
+			compatible = "qcom,mpm";
+			qcom,rpm-msg-ram = <&apss_mpm>;
+			interrupts = <GIC_SPI 171 IRQ_TYPE_EDGE_RISING>;
+			mboxes = <&apcs1 1>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			#power-domain-cells = <0>;
+			interrupt-parent = <&intc>;
+			qcom,mpm-pin-count = <64>;
+			qcom,mpm-pin-map = <2 184>,  /* TSENS uplow */
+					   <62 190>; /* SPMI */
+		};
 	};
 
 	smp2p-adsp {
@@ -748,8 +778,15 @@
 		};
 
 		rpm_msg_ram: sram@60000 {
-			compatible = "qcom,rpm-msg-ram";
+			compatible = "qcom,rpm-msg-ram", "mmio-sram";
 			reg = <0x00060000 0x8000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0x00060000 0x8000>;
+
+			apss_mpm: sram@1d0 {
+				reg = <0x1d0 0x48>;
+			};
 		};
 
 		sram@290000 {
@@ -1752,7 +1789,7 @@
 				    "intr",
 				    "cnfg";
 			interrupt-names = "periph_irq";
-			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
+			interrupts-extended = <&mpm 62 IRQ_TYPE_LEVEL_HIGH>;
 			qcom,ee = <0>;
 			qcom,channel = <0>;
 			#address-cells = <2>;
-- 
2.43.0


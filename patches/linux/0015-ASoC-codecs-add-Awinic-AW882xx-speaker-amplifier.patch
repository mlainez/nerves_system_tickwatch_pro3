From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nerves TicWatch Pro 3 maintainers <noreply@example.com>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH] ASoC: codecs: add Awinic AW882xx speaker amplifier

The TicWatch Pro 3 drives its speaker with an Awinic smart amplifier
reporting chip id 0x1852, which none of the mainline Awinic drivers
handle. Add a driver that runs it as a plain I2S amplifier: the
speaker protection algorithm Android ran on the ADSP is not used.

The stock firmware's aw882xx_spk_reg.bin register file is applied
before the first stream when present, followed by the voltage sense
calibration the vendor driver applies from the chip's efuse trims
(VTMCTRL3 from the EFRH and EFRM1 sense gain trims).

The PLL locks on the I2S bit clock. Through the ADSP that clock only
runs once the stream has started, after the codec has been unmuted, so
power-up and the wait for the lock run from a work item that unmute
schedules; mute cancels it and powers the amplifier down.
---
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -57,6 +57,7 @@
 	imply SND_SOC_AW87390
 	imply SND_SOC_AW88395
 	imply SND_SOC_AW88081
+	imply SND_SOC_AW882XX
 	imply SND_SOC_AW88166
 	imply SND_SOC_AW88261
 	imply SND_SOC_AW88399
@@ -675,6 +676,15 @@
 	  digital Smart K audio amplifier with an integrated 10V
 	  smart boost convert.
 
+config SND_SOC_AW882XX
+	tristate "Soc Audio for awinic aw882xx"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  This option enables support for the Awinic AW882xx (chip id
+	  0x1852) I2S smart amplifier, driven as a plain speaker
+	  amplifier.
+
 config SND_SOC_AW88166
 	tristate "Soc Audio for awinic aw88166"
 	depends on I2C
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -49,6 +49,7 @@
 snd-soc-aw8738-y := aw8738.o
 snd-soc-aw87390-y := aw87390.o
 snd-soc-aw88081-y := aw88081.o
+snd-soc-aw882xx-y := aw882xx.o
 snd-soc-aw88395-lib-y := aw88395/aw88395_lib.o \
 			aw88395/aw88395_device.o
 snd-soc-aw88395-y := aw88395/aw88395.o
@@ -487,6 +488,7 @@
 obj-$(CONFIG_SND_SOC_AW8738)	+= snd-soc-aw8738.o
 obj-$(CONFIG_SND_SOC_AW87390)	+= snd-soc-aw87390.o
 obj-$(CONFIG_SND_SOC_AW88081)	+= snd-soc-aw88081.o
+obj-$(CONFIG_SND_SOC_AW882XX)	+= snd-soc-aw882xx.o
 obj-$(CONFIG_SND_SOC_AW88395_LIB) += snd-soc-aw88395-lib.o
 obj-$(CONFIG_SND_SOC_AW88395)	+=snd-soc-aw88395.o
 obj-$(CONFIG_SND_SOC_AW88166)	+=snd-soc-aw88166.o
--- /dev/null
+++ b/sound/soc/codecs/aw882xx.c
@@ -0,0 +1,552 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// aw882xx.c -- Awinic AW882xx (chip id 0x1852) smart amplifier
+//
+// The amplifier is used as a plain I2S speaker amplifier: the speaker
+// protection algorithm the Android driver ran on the ADSP is not used.
+// A board register file, as shipped with the stock firmware, is applied
+// before the first power-up when present, followed by the voltage sense
+// calibration the vendor driver applies from the chip's efuse trims.
+//
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define AW882XX_ID		0x00
+#define AW882XX_SYSST		0x01
+#define AW882XX_SYSINT		0x02
+#define AW882XX_SYSCTRL		0x04
+#define AW882XX_SYSCTRL2	0x05
+#define AW882XX_I2SCTRL		0x06
+#define AW882XX_HAGCCFG4	0x0c
+#define AW882XX_VTMCTRL3	0x56
+#define AW882XX_PLLCTRL1	0x66
+#define AW882XX_EFRH		0x78
+#define AW882XX_EFRM1		0x7a
+#define AW882XX_REG_MAX		0x7c
+
+#define AW882XX_CHIP_ID		0x1852
+
+/*
+ * Undervoltage, boost overcurrent, overcurrent and overtemperature must be
+ * clear; boost done, switching, clock and PLL locked must be set.
+ */
+#define AW882XX_SYSST_MASK	0x4b1b
+#define AW882XX_SYSST_OK	0x0311
+
+#define AW882XX_SYSCTRL_AMPPD	BIT(1)
+#define AW882XX_SYSCTRL_PWDN	BIT(0)
+
+#define AW882XX_SYSCTRL2_HMUTE	BIT(4)
+
+#define AW882XX_I2SCTRL_CHSEL	GENMASK(11, 10)
+#define AW882XX_I2SCTRL_I2SMD	GENMASK(9, 8)
+#define AW882XX_I2SCTRL_I2SFS	GENMASK(7, 6)
+#define AW882XX_I2SCTRL_I2SBCK	GENMASK(5, 4)
+#define AW882XX_I2SCTRL_I2SSR	GENMASK(3, 0)
+
+#define AW882XX_CHSEL_MONO	3	/* (L + R) / 2 */
+
+/* Set for every rate except 8, 16 and 32 kHz. */
+#define AW882XX_PLLCTRL1_CCO_MUX	BIT(14)
+
+#define AW882XX_HAGCCFG4_VOL	GENMASK(15, 8)
+
+/* The efuse trims of the current and voltage sense paths: 10-bit signed. */
+#define AW882XX_EF_GESLP	GENMASK(9, 0)
+
+/* Attenuation in 0.5 dB steps, from 0 dB down to -90 dB. */
+#define AW882XX_VOL_STEPS	180
+
+#define AW882XX_FW_NAME		"aw882xx_spk_reg.bin"
+
+struct aw882xx {
+	struct regmap *regmap;
+	struct gpio_desc *reset;
+	struct device *dev;
+	unsigned int volume;
+	bool fw_tried;
+	struct work_struct start_work;
+};
+
+static const struct regmap_config aw882xx_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.max_register = AW882XX_REG_MAX,
+	.reg_format_endian = REGMAP_ENDIAN_LITTLE,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+/*
+ * The volume field holds an attenuation: the high nibble in 6 dB steps,
+ * the low nibble in 0.5 dB steps from 0 to 11.
+ */
+static unsigned int aw882xx_vol_to_reg(unsigned int volume)
+{
+	unsigned int atten = AW882XX_VOL_STEPS - volume;
+
+	return (atten / 12) << 4 | atten % 12;
+}
+
+static int aw882xx_write_volume(struct aw882xx *aw)
+{
+	return regmap_update_bits(aw->regmap, AW882XX_HAGCCFG4,
+				  AW882XX_HAGCCFG4_VOL,
+				  FIELD_PREP(AW882XX_HAGCCFG4_VOL,
+					     aw882xx_vol_to_reg(aw->volume)));
+}
+
+static s16 aw882xx_trim(struct aw882xx *aw, unsigned int reg)
+{
+	unsigned int val = 0;
+
+	regmap_read(aw->regmap, reg, &val);
+
+	return sign_extend32(val & AW882XX_EF_GESLP, 9);
+}
+
+/*
+ * What the vendor driver does after loading the register file: scale the
+ * voltage sense to the current sense using their efuse trims.
+ */
+static int aw882xx_set_vcalb(struct aw882xx *aw)
+{
+	int icalk = 1000 + aw882xx_trim(aw, AW882XX_EFRM1);
+	int vcalk = 1000 + aw882xx_trim(aw, AW882XX_EFRH);
+
+	return regmap_write(aw->regmap, AW882XX_VTMCTRL3,
+			    (1 << 13) * icalk / vcalk);
+}
+
+/*
+ * The register file is a list of little-endian (u16 address, u16 value)
+ * records, written in order.
+ */
+static void aw882xx_apply_board_config(struct aw882xx *aw)
+{
+	const struct firmware *fw;
+	size_t i;
+	int ret;
+
+	ret = firmware_request_nowarn(&fw, AW882XX_FW_NAME, aw->dev);
+	if (ret) {
+		dev_info(aw->dev, "no %s, using register defaults\n",
+			 AW882XX_FW_NAME);
+		return;
+	}
+
+	for (i = 0; i + 4 <= fw->size; i += 4) {
+		unsigned int reg = get_unaligned_le16(&fw->data[i]);
+		unsigned int val = get_unaligned_le16(&fw->data[i + 2]);
+
+		if (reg > AW882XX_REG_MAX)
+			continue;
+
+		ret = regmap_write(aw->regmap, reg, val);
+		if (ret) {
+			dev_err(aw->dev, "%s: writing 0x%02x failed: %d\n",
+				AW882XX_FW_NAME, reg, ret);
+			break;
+		}
+	}
+
+	dev_info(aw->dev, "applied %s (%zu registers)\n", AW882XX_FW_NAME,
+		 fw->size / 4);
+	release_firmware(fw);
+}
+
+static int aw882xx_wait_pll(struct aw882xx *aw)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read_poll_timeout(aw->regmap, AW882XX_SYSST, val,
+				       (val & AW882XX_SYSST_MASK) == AW882XX_SYSST_OK,
+				       5000, 500000);
+	if (ret)
+		dev_err(aw->dev, "did not start, SYSST=0x%04x\n", val);
+
+	return ret;
+}
+
+static void aw882xx_power_down(struct aw882xx *aw)
+{
+	regmap_set_bits(aw->regmap, AW882XX_SYSCTRL2, AW882XX_SYSCTRL2_HMUTE);
+	regmap_set_bits(aw->regmap, AW882XX_SYSCTRL, AW882XX_SYSCTRL_PWDN);
+}
+
+static void aw882xx_load_board_config(struct aw882xx *aw)
+{
+	int ret;
+
+	aw->fw_tried = true;
+
+	aw882xx_apply_board_config(aw);
+
+	ret = aw882xx_set_vcalb(aw);
+	if (ret)
+		dev_err(aw->dev, "voltage sense calibration failed: %d\n", ret);
+
+	/* Leave the amp muted and down whatever the register file set. */
+	aw882xx_power_down(aw);
+}
+
+static int aw882xx_power_up(struct aw882xx *aw)
+{
+	int ret;
+
+	ret = regmap_clear_bits(aw->regmap, AW882XX_SYSCTRL,
+				AW882XX_SYSCTRL_PWDN | AW882XX_SYSCTRL_AMPPD);
+	if (ret)
+		return ret;
+
+	ret = aw882xx_wait_pll(aw);
+	if (ret) {
+		aw882xx_power_down(aw);
+		return ret;
+	}
+
+	ret = aw882xx_write_volume(aw);
+	if (ret)
+		return ret;
+
+	return regmap_clear_bits(aw->regmap, AW882XX_SYSCTRL2,
+				 AW882XX_SYSCTRL2_HMUTE);
+}
+
+static int aw882xx_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		return -EINVAL;
+
+	if ((fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_BC_FC)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int aw882xx_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct aw882xx *aw = snd_soc_component_get_drvdata(dai->component);
+	unsigned int sr, fs, bck, cco_mux;
+	int ret;
+
+	if (!aw->fw_tried)
+		aw882xx_load_board_config(aw);
+
+	cco_mux = AW882XX_PLLCTRL1_CCO_MUX;
+	switch (params_rate(params)) {
+	case 8000:
+		sr = 0;
+		cco_mux = 0;
+		break;
+	case 16000:
+		sr = 3;
+		cco_mux = 0;
+		break;
+	case 32000:
+		sr = 6;
+		cco_mux = 0;
+		break;
+	case 44100:
+		sr = 7;
+		break;
+	case 48000:
+		sr = 8;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (params_width(params)) {
+	case 16:
+		fs = 0;
+		break;
+	case 24:
+		fs = 2;
+		break;
+	case 32:
+		fs = 3;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Bit clock to frame clock ratio: two slots of the physical width. */
+	switch (params_physical_width(params)) {
+	case 16:
+		bck = 0;	/* 32 fs */
+		break;
+	case 24:
+		bck = 1;	/* 48 fs */
+		break;
+	case 32:
+		bck = 2;	/* 64 fs */
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ret = regmap_update_bits(aw->regmap, AW882XX_PLLCTRL1,
+				 AW882XX_PLLCTRL1_CCO_MUX, cco_mux);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(aw->regmap, AW882XX_I2SCTRL,
+				  AW882XX_I2SCTRL_CHSEL | AW882XX_I2SCTRL_I2SMD |
+				  AW882XX_I2SCTRL_I2SFS | AW882XX_I2SCTRL_I2SBCK |
+				  AW882XX_I2SCTRL_I2SSR,
+				  FIELD_PREP(AW882XX_I2SCTRL_CHSEL, AW882XX_CHSEL_MONO) |
+				  FIELD_PREP(AW882XX_I2SCTRL_I2SFS, fs) |
+				  FIELD_PREP(AW882XX_I2SCTRL_I2SBCK, bck) |
+				  FIELD_PREP(AW882XX_I2SCTRL_I2SSR, sr));
+}
+
+static void aw882xx_start(struct work_struct *work)
+{
+	struct aw882xx *aw = container_of(work, struct aw882xx, start_work);
+	int ret;
+
+	ret = aw882xx_power_up(aw);
+	if (ret)
+		dev_err(aw->dev, "failed to start: %d\n", ret);
+}
+
+/*
+ * The PLL locks on the I2S bit clock. Through the ADSP, that clock only
+ * runs once the stream has started, which is after the codec is unmuted,
+ * so waiting for the lock here would always time out. Power up and wait
+ * for the lock from a work item instead.
+ */
+static int aw882xx_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct aw882xx *aw = snd_soc_component_get_drvdata(dai->component);
+
+	if (mute) {
+		cancel_work_sync(&aw->start_work);
+		aw882xx_power_down(aw);
+		return 0;
+	}
+
+	schedule_work(&aw->start_work);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops aw882xx_dai_ops = {
+	.set_fmt = aw882xx_set_fmt,
+	.hw_params = aw882xx_hw_params,
+	.mute_stream = aw882xx_mute_stream,
+	.no_capture_mute = 1,
+};
+
+static struct snd_soc_dai_driver aw882xx_dai = {
+	.name = "aw882xx-aif",
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_16000 |
+			 SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+			 SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE |
+			   SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &aw882xx_dai_ops,
+};
+
+static int aw882xx_volume_info(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = AW882XX_VOL_STEPS;
+	return 0;
+}
+
+static int aw882xx_volume_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw882xx *aw = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = aw->volume;
+	return 0;
+}
+
+static int aw882xx_volume_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct aw882xx *aw = snd_soc_component_get_drvdata(component);
+	long volume = ucontrol->value.integer.value[0];
+	int ret;
+
+	if (volume < 0 || volume > AW882XX_VOL_STEPS)
+		return -EINVAL;
+
+	if (volume == aw->volume)
+		return 0;
+
+	aw->volume = volume;
+	ret = aw882xx_write_volume(aw);
+
+	return ret ? ret : 1;
+}
+
+static const DECLARE_TLV_DB_SCALE(aw882xx_volume_tlv, -9000, 50, 0);
+
+static const struct snd_kcontrol_new aw882xx_controls[] = {
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Volume",
+		.access = SNDRV_CTL_ELEM_ACCESS_READWRITE |
+			  SNDRV_CTL_ELEM_ACCESS_TLV_READ,
+		.tlv.p = aw882xx_volume_tlv,
+		.info = aw882xx_volume_info,
+		.get = aw882xx_volume_get,
+		.put = aw882xx_volume_put,
+	},
+};
+
+static const struct snd_soc_dapm_widget aw882xx_dapm_widgets[] = {
+	SND_SOC_DAPM_AIF_IN("AIF IN", "Playback", 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_OUTPUT("OUT"),
+};
+
+static const struct snd_soc_dapm_route aw882xx_dapm_routes[] = {
+	{ "OUT", NULL, "AIF IN" },
+};
+
+static const struct snd_soc_component_driver aw882xx_component = {
+	.controls = aw882xx_controls,
+	.num_controls = ARRAY_SIZE(aw882xx_controls),
+	.dapm_widgets = aw882xx_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(aw882xx_dapm_widgets),
+	.dapm_routes = aw882xx_dapm_routes,
+	.num_dapm_routes = ARRAY_SIZE(aw882xx_dapm_routes),
+	.endianness = 1,
+};
+
+static void aw882xx_disable_dvdd(void *data)
+{
+	regulator_disable(data);
+}
+
+/* The digital supply is a 1.8 V rail; its regulator may allow a range. */
+static int aw882xx_enable_dvdd(struct device *dev)
+{
+	struct regulator *dvdd;
+	int ret;
+
+	dvdd = devm_regulator_get_optional(dev, "dvdd");
+	if (IS_ERR(dvdd)) {
+		if (PTR_ERR(dvdd) == -ENODEV)
+			return 0;
+		return dev_err_probe(dev, PTR_ERR(dvdd), "failed to get dvdd\n");
+	}
+
+	ret = regulator_set_voltage(dvdd, 1800000, 1800000);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set dvdd to 1.8 V\n");
+
+	ret = regulator_enable(dvdd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable dvdd\n");
+
+	return devm_add_action_or_reset(dev, aw882xx_disable_dvdd, dvdd);
+}
+
+static int aw882xx_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct aw882xx *aw;
+	unsigned int id;
+	int ret;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->dev = dev;
+	/* -6 dB leaves headroom for a speaker the size of a watch's. */
+	aw->volume = AW882XX_VOL_STEPS - 12;
+	i2c_set_clientdata(i2c, aw);
+
+	ret = devm_work_autocancel(dev, &aw->start_work, aw882xx_start);
+	if (ret)
+		return ret;
+
+	aw->regmap = devm_regmap_init_i2c(i2c, &aw882xx_regmap_config);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw->regmap),
+				     "failed to init regmap\n");
+
+	ret = aw882xx_enable_dvdd(dev);
+	if (ret)
+		return ret;
+
+	aw->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset))
+		return dev_err_probe(dev, PTR_ERR(aw->reset),
+				     "failed to get reset gpio\n");
+
+	if (aw->reset) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(aw->reset, 0);
+		usleep_range(2000, 3000);
+	}
+
+	ret = regmap_read(aw->regmap, AW882XX_ID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+
+	if (id != AW882XX_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected chip id 0x%04x\n", id);
+
+	aw882xx_power_down(aw);
+
+	return devm_snd_soc_register_component(dev, &aw882xx_component,
+					       &aw882xx_dai, 1);
+}
+
+static const struct of_device_id aw882xx_of_match[] = {
+	{ .compatible = "awinic,aw882xx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw882xx_of_match);
+
+static const struct i2c_device_id aw882xx_i2c_id[] = {
+	{ "aw882xx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw882xx_i2c_id);
+
+static struct i2c_driver aw882xx_i2c_driver = {
+	.driver = {
+		.name = "aw882xx",
+		.of_match_table = aw882xx_of_match,
+	},
+	.probe = aw882xx_i2c_probe,
+	.id_table = aw882xx_i2c_id,
+};
+module_i2c_driver(aw882xx_i2c_driver);
+
+MODULE_DESCRIPTION("Awinic AW882xx smart amplifier driver");
+MODULE_LICENSE("GPL");

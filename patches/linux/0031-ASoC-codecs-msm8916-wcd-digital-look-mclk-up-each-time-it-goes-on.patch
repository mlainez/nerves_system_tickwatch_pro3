From: Lars Wikman <lars@underjord.io>
Subject: [PATCH] ASoC: codecs: msm8916-wcd-digital: look mclk up each time it goes on

With the codec behind the ADSP, mclk is one of the ADSP's q6afe clocks.
A restarted ADSP unregisters its clocks and registers new ones, and the
handle the codec took at probe was left pointing at a dead clock: audio
stayed broken after a restart even where it didn't oops (see the
clk_unregister() fix before this).

Take the clock when it is turned on and put it when it goes off again,
and keep the rate the machine driver sets so a new clock gets it too.
Probe still looks it up once, so the codec defers until the ADSP is up.

Signed-off-by: Lars Wikman <lars@underjord.io>
---
--- a/sound/soc/codecs/msm8916-wcd-digital.c
+++ b/sound/soc/codecs/msm8916-wcd-digital.c
@@ -231,15 +231,21 @@ struct wcd_iir_filter_ctl {
  * ADSP keeps XO running, even asleep, so the SoC never reaches XO shutdown.
  * Hold it only for register writes and open streams, and let it go once the
  * codec has been idle for MCLK_IDLE_MS.
+ *
+ * The ADSP can also be restarted, which unregisters its clocks and registers
+ * new ones, so look mclk up each time it is turned on rather than keeping a
+ * handle to a clock that may be gone.
  */
 #define MCLK_IDLE_MS	50
 
 struct msm8916_wcd_digital_priv {
-	struct clk *ahbclk, *mclk;
+	struct device *dev;
+	struct clk *ahbclk;
+	struct clk *mclk;	/* only while on */
 	void __iomem *base;
-	struct mutex mclk_lock;	/* protects mclk_users and mclk_on */
+	struct mutex mclk_lock;	/* protects mclk, mclk_rate and mclk_users */
+	unsigned long mclk_rate;
 	unsigned int mclk_users;
-	bool mclk_on;
 	struct delayed_work mclk_off_work;
 };
 
@@ -838,6 +844,7 @@ static int msm8916_wcd_digital_get_clks(struct platform_device *pdev,
 					struct msm8916_wcd_digital_priv	*priv)
 {
 	struct device *dev = &pdev->dev;
+	struct clk *mclk;
 
 	priv->ahbclk = devm_clk_get(dev, "ahbix-clk");
 	if (IS_ERR(priv->ahbclk)) {
@@ -845,11 +852,11 @@ static int msm8916_wcd_digital_get_clks(struct platform_device *pdev,
 		return PTR_ERR(priv->ahbclk);
 	}
 
-	priv->mclk = devm_clk_get(dev, "mclk");
-	if (IS_ERR(priv->mclk)) {
-		dev_err(dev, "failed to get mclk\n");
-		return PTR_ERR(priv->mclk);
-	}
+	/* Only wait for it to exist; msm8916_wcd_digital_mclk_get() takes it */
+	mclk = clk_get(dev, "mclk");
+	if (IS_ERR(mclk))
+		return dev_err_probe(dev, PTR_ERR(mclk), "failed to get mclk\n");
+	clk_put(mclk);
 
 	return 0;
 }
@@ -868,8 +875,15 @@ static int msm8916_wcd_digital_component_set_sysclk(struct snd_soc_component *co
 						unsigned int freq, int dir)
 {
 	struct msm8916_wcd_digital_priv *p = dev_get_drvdata(component->dev);
+	int ret = 0;
 
-	return clk_set_rate(p->mclk, freq);
+	mutex_lock(&p->mclk_lock);
+	p->mclk_rate = freq;
+	if (p->mclk)
+		ret = clk_set_rate(p->mclk, freq);
+	mutex_unlock(&p->mclk_lock);
+
+	return ret;
 }
 
 static int msm8916_wcd_digital_hw_params(struct snd_pcm_substream *substream,
@@ -1082,16 +1096,48 @@ static const struct snd_soc_dapm_route msm8916_wcd_digital_audio_map[] = {
 
 };
 
+static int msm8916_wcd_digital_mclk_on(struct msm8916_wcd_digital_priv *priv)
+{
+	struct clk *mclk;
+	int ret;
+
+	mclk = clk_get(priv->dev, "mclk");
+	if (IS_ERR(mclk))
+		return PTR_ERR(mclk);
+
+	/* A restarted ADSP's clock has forgotten the rate */
+	if (priv->mclk_rate) {
+		ret = clk_set_rate(mclk, priv->mclk_rate);
+		if (ret)
+			goto err_put;
+	}
+
+	ret = clk_prepare_enable(mclk);
+	if (ret)
+		goto err_put;
+
+	priv->mclk = mclk;
+	return 0;
+
+err_put:
+	clk_put(mclk);
+	return ret;
+}
+
+static void msm8916_wcd_digital_mclk_release(struct msm8916_wcd_digital_priv *priv)
+{
+	clk_disable_unprepare(priv->mclk);
+	clk_put(priv->mclk);
+	priv->mclk = NULL;
+}
+
 static int msm8916_wcd_digital_mclk_get(struct msm8916_wcd_digital_priv *priv)
 {
 	int ret = 0;
 
 	mutex_lock(&priv->mclk_lock);
-	if (!priv->mclk_on) {
-		ret = clk_prepare_enable(priv->mclk);
-		if (!ret)
-			priv->mclk_on = true;
-	}
+	if (!priv->mclk)
+		ret = msm8916_wcd_digital_mclk_on(priv);
 	if (!ret)
 		priv->mclk_users++;
 	mutex_unlock(&priv->mclk_lock);
@@ -1115,10 +1161,8 @@ static void msm8916_wcd_digital_mclk_off(struct work_struct *work)
 			     mclk_off_work.work);
 
 	mutex_lock(&priv->mclk_lock);
-	if (!priv->mclk_users && priv->mclk_on) {
-		clk_disable_unprepare(priv->mclk);
-		priv->mclk_on = false;
-	}
+	if (!priv->mclk_users && priv->mclk)
+		msm8916_wcd_digital_mclk_release(priv);
 	mutex_unlock(&priv->mclk_lock);
 }
 
@@ -1275,6 +1319,7 @@ static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 	if (IS_ERR(base))
 		return PTR_ERR(base);
 
+	priv->dev = dev;
 	priv->base = base;
 	mutex_init(&priv->mclk_lock);
 	INIT_DELAYED_WORK(&priv->mclk_off_work, msm8916_wcd_digital_mclk_off);
@@ -1306,8 +1351,8 @@ static int msm8916_wcd_digital_probe(struct platform_device *pdev)
 
 err_clk:
 	cancel_delayed_work_sync(&priv->mclk_off_work);
-	if (priv->mclk_on)
-		clk_disable_unprepare(priv->mclk);
+	if (priv->mclk)
+		msm8916_wcd_digital_mclk_release(priv);
 	clk_disable_unprepare(priv->ahbclk);
 	return ret;
 }
@@ -1317,8 +1362,8 @@ static void msm8916_wcd_digital_remove(struct platform_device *pdev)
 	struct msm8916_wcd_digital_priv *priv = dev_get_drvdata(&pdev->dev);
 
 	cancel_delayed_work_sync(&priv->mclk_off_work);
-	if (priv->mclk_on)
-		clk_disable_unprepare(priv->mclk);
+	if (priv->mclk)
+		msm8916_wcd_digital_mclk_release(priv);
 	clk_disable_unprepare(priv->ahbclk);
 }
 
-- 
2.43.0

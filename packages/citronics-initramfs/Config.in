config BR2_PACKAGE_CITRONICS_INITRAMFS
        bool "citronics-initramfs [TicWatch Pro 3]"
        depends on !BR2_STATIC_LIBS
        depends on BR2_USE_MMU
        depends on BR2_TOOLCHAIN_HAS_THREADS
        depends on BR2_INSTALL_LIBSTDCPP
        select BR2_PACKAGE_BUSYBOX
        select BR2_PACKAGE_UNUDHCPD
        select BR2_PACKAGE_MULTIPATH_TOOLS
        select BR2_PACKAGE_PARTED
        select BR2_PACKAGE_E2FSPROGS
        select BR2_PACKAGE_E2FSPROGS_RESIZE2FS
        select BR2_PACKAGE_UTIL_LINUX_BINARIES
        help
          Early-boot initramfs. lk2nd loads it alongside the kernel; it
          maps the Nerves subpartitions out of the stock `userdata`
          partition with kpartx, mounts the squashfs rootfs and pivots
          into it. If any of that fails it brings up USB networking and
          a telnet shell instead of leaving you with a black screen.

          Patched here to find `userdata` by GPT name rather than by a
          hardcoded eMMC partition number — see the package's 0003 patch.

#!/bin/sh
# Bring up the hardware that needs firmware staged first.
#
# Nerves has no init system: erlinit is PID 1 and starts the BEAM. Nothing
# else runs, so this script is the one place where the ordering below is
# expressed. erlinit calls it through --pre-run-exec (see
# /etc/erlinit.config), which runs after the -m mounts are in place and
# before Erlang starts.
#
# Order matters and is the whole point:
#
#   1. stage the calibration data off the stock Android partitions
#   2. point the kernel firmware loader at it
#   3. only then load the drivers that will ask for it
#
# Get that backwards and brcmfmac asks for its NVRAM before it exists,
# gets nothing, and the interface never comes up. postmarketOS solves the
# same problem by ordering msm-firmware-loader ahead of module loading.
#
# The drivers cannot simply be built into the kernel instead: the files
# they need live on a partition that is not mounted until erlinit mounts
# it, long after a built-in driver would have probed.
#
# The BCM43430A1's chip firmware is generic and ships in the rootfs. Its
# calibration data is not: the Wi-Fi NVRAM carries this watch's MAC
# address, and both it and the Bluetooth patch RAM image live on the stock
# Android partitions under names the downstream bcmdhd driver used. So
# rather than copy anything into the image, mount those partitions
# read-only, symlink what we find into a tmpfs under the names brcmfmac
# and hci_bcm expect, and point the kernel's firmware loader at it.
#
# firmware_class.path is searched *before* /lib/firmware, so this
# supplements the shipped firmware rather than replacing it.
#
# Exits 0 whatever happens. A watch with no Wi-Fi is still a working watch,
# and a non-zero exit here would stop the BEAM from ever starting.

set -u

FWDIR=/run/firmware
PARAM=/sys/module/firmware_class/parameters/path

# Log to the kernel ring buffer as well as stdout. erlinit sends this
# script's stdout to the console, which on a watch scrolls past before
# anyone can read it; the ring buffer is still there afterwards under
# `dmesg | grep ticwatch-bringup`.
log() {
	echo "ticwatch-bringup: $*"
	[ -w /dev/kmsg ] && echo "ticwatch-bringup: $*" > /dev/kmsg 2>/dev/null
	return 0
}

# Keep frequency scaling demand-driven even if another boot stage changed it.
# This is not a substitute for working CPU idle/suspend support.
for policy in /sys/devices/system/cpu/cpufreq/policy*; do
	[ -f "$policy/scaling_available_governors" ] || continue
	case " $(cat "$policy/scaling_available_governors") " in
		*" schedutil "*)
			if printf '%s' schedutil > "$policy/scaling_governor"; then
				log "CPU ${policy##*/}: governor=$(cat "$policy/scaling_governor")"
			else
				log "could not select schedutil for ${policy##*/}"
			fi
			;;
		*) log "schedutil unavailable for ${policy##*/}" ;;
	esac
done

# brcmfmac builds the NVRAM filename from the device tree: it appends the
# `brcm,board-type` property, or failing that the root node's compatible
# string, to the chip name. Our device tree sets no board-type, so the
# name it looks for is "brcmfmac43430-sdio.mobvoi,rover.txt" — and it
# falls back to the bare "brcmfmac43430-sdio.txt". Provide both.
NVRAM_NAMES="brcmfmac43430-sdio.mobvoi,rover.txt brcmfmac43430-sdio.txt"

# What the stock firmware calls the same files. bcmdhd used .cal or
# nvram.txt; the Android Bluetooth stack used a .hcd patch RAM image.
NVRAM_CANDIDATES="bcmdhd.cal nvram.txt nvram_43430.txt nvram_43438a1.txt bcmdhd_43430.cal nvram_mfg.txt"
HCD_CANDIDATES="BCM43430A1.hcd bcm43430a1.hcd BCM4343A1.hcd"

# Where Android tends to keep them. /persist is searched too because some
# builds put the per-unit calibration there rather than on /vendor.
SEARCH_DIRS="
	/mnt/vendor/firmware
	/mnt/vendor/etc/firmware
	/mnt/vendor/etc/wifi
	/mnt/vendor/firmware/wlan
	/mnt/persist
	/mnt/persist/firmware
	/mnt/persist/wlan
"

find_file() {
	# Look for any of $2... under the search dirs, shallowly first so an
	# exact hit wins over a deep one.
	for d in $SEARCH_DIRS; do
		[ -d "$d" ] || continue
		for n in $1; do
			if [ -f "$d/$n" ]; then
				echo "$d/$n"
				return 0
			fi
		done
	done
	for d in $SEARCH_DIRS; do
		[ -d "$d" ] || continue
		for n in $1; do
			f=$(find "$d" -maxdepth 3 -type f -name "$n" 2>/dev/null | head -n1)
			if [ -n "$f" ]; then
				echo "$f"
				return 0
			fi
		done
	done
	return 1
}

mkdir -p "$FWDIR/brcm"

found_any=0

if nvram=$(find_file "$NVRAM_CANDIDATES"); then
	log "Wi-Fi NVRAM: $nvram"
	for n in $NVRAM_NAMES; do
		ln -sf "$nvram" "$FWDIR/brcm/$n"
	done
	found_any=1
else
	log "no Wi-Fi NVRAM found; brcmfmac will load but the interface will not come up"
	log "  looked for: $NVRAM_CANDIDATES"
	log "  under: $(echo $SEARCH_DIRS | tr '\n' ' ')"
fi

if hcd=$(find_file "$HCD_CANDIDATES"); then
	log "Bluetooth patch RAM: $hcd"
	ln -sf "$hcd" "$FWDIR/brcm/BCM43430A1.hcd"
	found_any=1
else
	log "no Bluetooth .hcd found; the controller will run unpatched firmware"
fi

# Audio. The ADSP runs Qualcomm's stock audio firmware, which ships on the
# FAT-formatted NON-HLOS partition alongside the modem's. The speaker
# amplifier's board register file, when present, is on /vendor.
#
# /root/.no-adsp leaves the ADSP unbooted, for measuring power without it:
# once booted it stays awake and holds XO on.
NO_ADSP=/root/.no-adsp
MODEM_PARTNAMES="modem modem_a apnhlos"
MODEM_MNT=/mnt/modem

find_partition() {
	for uevent in /sys/class/block/*/uevent; do
		partname=$(sed -n 's/^PARTNAME=//p' "$uevent")
		for want in $1; do
			if [ "$partname" = "$want" ]; then
				echo "/dev/$(sed -n 's/^DEVNAME=//p' "$uevent")"
				return 0
			fi
		done
	done
	return 1
}

if [ -e "$NO_ADSP" ]; then
	log "$NO_ADSP present; not staging the ADSP firmware, there will be no audio"
elif modem=$(find_partition "$MODEM_PARTNAMES") &&
	mount -t vfat -o ro,nodev,noexec,nosuid,shortname=lower "$modem" "$MODEM_MNT"; then
	found_adsp=0
	for f in "$MODEM_MNT"/image/adsp.* "$MODEM_MNT"/adsp.*; do
		[ -f "$f" ] || continue
		ln -sf "$f" "$FWDIR/${f##*/}"
		found_adsp=1
	done
	# A single-file image carries every segment, so the PIL loader can be
	# pointed at it under the split image's name.
	if [ ! -e "$FWDIR/adsp.mdt" ] && [ -e "$FWDIR/adsp.mbn" ]; then
		ln -sf adsp.mbn "$FWDIR/adsp.mdt"
	fi
	if [ "$found_adsp" = "1" ]; then
		log "ADSP firmware: $modem"
		found_any=1
	else
		log "no ADSP firmware on $modem; there will be no audio"
	fi
else
	log "could not mount a modem partition ($MODEM_PARTNAMES); there will be no audio"
fi

if amp=$(find_file "aw882xx_spk_reg.bin"); then
	log "speaker amplifier registers: $amp"
	ln -sf "$amp" "$FWDIR/aw882xx_spk_reg.bin"
	found_any=1
fi

if [ "$found_any" = "1" ]; then
	if [ -w "$PARAM" ]; then
		printf "%s" "$FWDIR" > "$PARAM"
		log "firmware_class.path set to $FWDIR"
	else
		log "cannot write $PARAM — is CONFIG_FW_LOADER built in?"
	fi
fi

# Load the drivers, now that anything they will ask for is in place.
#
# Nothing else would: there is no udev running to act on the SDIO and
# serdev uevents, and no init scripts. Without this the watch boots to a
# working Erlang prompt with no touchscreen, no Wi-Fi and no Bluetooth.
#
#   zinitix   touchscreen  — no firmware, listed here so there is one
#                            place that says what gets loaded
#   brcmfmac  Wi-Fi        — wants brcm/brcmfmac43430-sdio.bin plus the
#                            NVRAM staged above
#   hci_uart  Bluetooth    — pulls in btbcm, which wants the .hcd
#   nanohub   sensor hub   — stock hub firmware; never flashes it
#   qcom_q6v5_pas  ADSP    — boots the audio DSP from the firmware staged
#                            above; the sound card follows once it is up
#
# bcm4775-bbd is intentionally not loaded here. Its transport powers the GPS
# receiver, but it is not useful until an open userspace location engine exists.
for mod in zinitix brcmfmac hci_uart nanohub qcom_q6v5_pas; do
	if modprobe "$mod" 2>/dev/null; then
		log "loaded $mod"
	else
		log "could not load $mod"
	fi
done

# The playback route is MultiMedia1 (PCM device 0) into the Quaternary
# MI2S port that feeds the speaker amplifier; the capture route is the
# digital mic on Tertiary MI2S into MultiMedia2 (PCM device 1). The card
# appears only after the ADSP has booted, so set the routes from the
# background rather than delay Erlang for it.
if [ ! -e "$NO_ADSP" ]; then
	(
		i=0
		while [ "$i" -lt 60 ]; do
			if amixer -q -c 0 cset name='QUAT_MI2S_RX Audio Mixer MultiMedia1' 1 2>/dev/null; then
				log "speaker route enabled"
				if amixer -q -c 0 cset name='MultiMedia2 Mixer TERT_MI2S_TX' 1 2>/dev/null; then
					log "microphone route enabled"
				else
					log "could not set the microphone route"
				fi
				exit 0
			fi
			sleep 1
			i=$((i + 1))
		done
		log "no sound card after 60 s; audio routes not set"
	) >/dev/null 2>&1 &
fi

# SDIO probes asynchronously. Do not delay Erlang waiting for wlan0:
# VintageNet handles the interface appearing later. Applications should set
# a stable MAC through their VintageNet configuration (hello_watch uses
# HelloWatch.WiFi.stable_mac/0, derived from the eMMC CID).
log "firmware staged and module loading finished; continuing without waiting for wlan0"

exit 0

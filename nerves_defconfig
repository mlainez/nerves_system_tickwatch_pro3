BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.1/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.1-C0D130A.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
# Debug symbols are stripped from the target either way, but they inflate
# the staging sysroot and with it the published artifact. Turn them on
# locally when you actually need them.
# BR2_ENABLE_DEBUG is not set
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches ${NERVES_DEFCONFIG_DIR}/patches"
BR2_PACKAGE_OVERRIDE_FILE="${NERVES_DEFCONFIG_DIR}/local.mk"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
# eudev, not plain devtmpfs. Nothing here runs udevd — erlinit and the
# OTP release do the work, and the initramfs uses busybox mdev — but
# multipath-tools links against libudev, and multipath-tools is where
# kpartx comes from. kpartx is what maps the Nerves subpartitions out of
# the stock userdata partition at boot, so without this the watch does
# not get as far as mounting a rootfs.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"

# Kernel — msm89x7-mainline/linux, the same fork postmarketOS ships as
# linux-postmarketos-qcom-msm89x7. Pinned to the commit behind tag
# v7.1.3-r1 rather than to the tag or a branch: the Nerves artifact
# checksum is computed from package_files() in mix.exs, so a moving ref
# would let a stale prebuilt artifact be reused silently.
BR2_LINUX_KERNEL=y
# A tarball rather than a git clone. Buildroot's git backend fetches every
# ref, which on a Linux fork means several gigabytes and a long server-side
# pack; the tarball is one immutable file. The URL names the commit behind
# tag v7.1.3-r1 rather than the tag itself, so a moved tag cannot silently
# change which kernel gets built.
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/msm89x7-mainline/linux/archive/50f9719b10cef792432485b0139fbcb913316e07.tar.gz"
# The base config is postmarketOS's, verbatim; our deltas live in the
# fragment so that refreshing from pmaports is a copy rather than a merge.
# See linux-nerves.fragment for what we change and why.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="${NERVES_DEFCONFIG_DIR}/linux-7.1.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-nerves.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# One device tree covers both watches. Mobvoi's downstream tree calls the
# LTE board `rover` and the GPS board `rubyfish`; they are the same board
# with and without a modem, and mainline describes both with this file.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sdm429w-mobvoi-rover"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# Deliberately NOT BR2_LINUX_KERNEL_INSTALL_TARGET: the kernel is read by
# lk2nd from the ext2 boot subpartition (see scripts/create-boot-img.sh),
# so a second copy of an uncompressed ~20 MiB arm64 Image inside the
# squashfs would be dead weight.

# Busybox / base userland
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
# Add the applets the citronics initramfs needs (switch_root, mdev, seq,
# ln, telnetd, …) on top of the Nerves base config. See the fragment for
# the full list and the rationale.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox-ticwatch-pro3.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Required by the citronics initramfs to kpartx the stock userdata
# partition into its boot/rootfs/app subpartitions at boot.
BR2_PACKAGE_MULTIPATH_TOOLS=y
BR2_PACKAGE_PARTED=y

# Wi-Fi — Broadcom BCM43430A1 over SDIO, driven by brcmfmac.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# Match the official Nerves Raspberry Pi systems: let wpa_supplicant send its
# internal diagnostics to syslog. This is particularly important on the watch,
# where the SDIO link can disappear before an interactive shell can inspect it.
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y

# Interactive diagnostics over the USB Nerves IEx shell. These keep the image
# self-contained when Wi-Fi has failed: inspect nl80211 and driver state, trace
# processes, capture traffic, exercise throughput, and probe input/I2C/MMC/USB.
BR2_PACKAGE_IW=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_PROCPS_NG=y

# Bluetooth — same chip, HCI over UART (brcm,bcm43430a1-bt).
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# Host helpers. genext2fs builds the ext2 boot image that lk2nd reads;
# see scripts/create-boot-img.sh.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENEXT2FS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Nerves bookkeeping
BR2_NERVES_SYSTEM_NAME="nerves_system_tickwatch_pro3"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# Root filesystem: squashfs, A/B, nested inside the stock `userdata`
# partition. lk2nd reads /extlinux/extlinux.conf from the ext2 boot
# subpartition and loads the kernel, DTB and initramfs from it; the
# initramfs kpartx-maps userdata into boot + rootfs + app-data.
#
# LZ4 rather than XZ: it decompresses several times faster for a modest
# size cost, and this SoC is four 1.7 GHz A53s.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# This system's own packages — see packages/README.md.
BR2_PACKAGE_CITRONICS_INITRAMFS=y
BR2_PACKAGE_BCM4775_DRIVER=y
BR2_PACKAGE_ANDROID_GPS_COMPAT=y
BR2_PACKAGE_NANOHUB_DRIVER=y
BR2_PACKAGE_UNUDHCPD=y
BR2_PACKAGE_QBOOTCTL=y
BR2_PACKAGE_REBOOT_MODE=y
BR2_PACKAGE_TICWATCH_PRO3_FIRMWARE=y
